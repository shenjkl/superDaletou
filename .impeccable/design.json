      "css": ".ds-tags{display:flex;gap:7px;flex-wrap:wrap}.ds-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;white-space:nowrap;font:11px/1.65 'Segoe UI','Microsoft YaHei UI',sans-serif}.ds-green{color:var(--teal,#246e64);background:var(--teal-soft,#eaf4f0)}.ds-amber{color:var(--amber,#8a5a1e);background:var(--amber-soft,#fff4e3)}.ds-blue{color:var(--primary,#365dca);background:var(--primary-soft,#eef2ff)}"
