    },
    {
      "name": "研究阶段线",
      "kind": "custom",
      "description": "四阶段的流程位置，当前项带光圈，每阶段都有文字。",
      "html": "<div class=\"ds-stages\"><div class=\"ds-stage ds-done\">固定方法</div><div class=\"ds-stage ds-done\">留存组合</div><div class=\"ds-stage ds-current\">等待开奖</div><div class=\"ds-stage\">评估证据</div></div>",
      "css": ".ds-stages{display:grid;grid-template-columns:repeat(4,1fr);font:11px/1.6 'Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--muted,#607087)}.ds-stage{position:relative;padding-top:27px}.ds-stage:before{content:'';position:absolute;top:8px;left:0;right:0;height:2px;background:#e4eaf3}.ds-stage:after{content:'';position:absolute;top:4px;left:0;width:10px;height:10px;border:2px solid white;border-radius:50%;background:#d4ddea}.ds-stage:last-child:before{display:none}.ds-done:before{background:#a8c9c3}.ds-done:after{background:var(--teal,#246e64)}.ds-current:after{background:var(--primary,#365dca);box-shadow:0 0 0 3px #e6edfc}"
    }
  ],
  "narrative": {
    "northStar": "研究工作台",
    "overview": "本文件按已实现的静态 HTML/CSS/JavaScript 扫描记录，依据为 `prototype/styles.css`、`prototype/index.html` 的合同、`prototype/app.js` 及桌面与手机概览截图。它描述当前原型的视觉事实，不代表生产框架或真实训练能力已经落地。名称是对既有工作台方向的描述，不新增品牌承诺。\n\n整体是浅灰蓝工作面、白色台账和深蓝文字的轻量操作环境。主操作集中用钴蓝，核验状态用青绿，待确认用赭色，错误用暗红。信息密度适合个人重复查看；边框、间距、标题和状态文字共同建立层级。",
    "keyCharacteristics": [
      "浅色固定导航与白色工作容器，细分隔线组织内容。",
      "中文系统字体、紧凑说明文字、对齐的数字及可换行的摘要哈希。",
      "状态保留文字标签；真实快照、历史探索与交互演示可辨认。",
      "深度主要由平面色块与边框表达，遮罩和抽屉才使用明显投影。"
    ],
    "rules": [
      {
        "name": "The 状态可读 Rule",
        "body": "当前实现同时提供状态文字与色彩；新增状态也要保留可读文字，不能只靠圆点或颜色表达。",
        "section": "colors"
      },
      {
        "name": "The 平放面板 Rule",
        "body": "面板默认依靠边框和色差；不要给现有普通内容容器增加悬浮阴影来替代其层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 沿用前置 token 与现有系统字体栈，使用文字解释每种研究状态。",
      "**Do** 为真实快照、历史探索和演示操作保留清楚的标签及时间边界。",
      "**Do** 让比较表格的数字右对齐，并在窄屏通过横向滚动保留列结构。",
      "**Do** 对新操作延续可见焦点、表单标签与明确错误文字。"
    ],
    "donts": [
      "**Don't** 把演示完成、已核验或绿色状态表达为已经证明盈利或优于随机。",
      "**Don't** 用虚构收益曲线填充尚无结算结果的空状态。",
      "**Don't** 将状态标签一律处理为可点击筛选器，或为普通面板添加额外浮动阴影。",
      "**Don't** 把当前概览的研究日历构图、静态数据日期或原型框架推广为全局品牌约束。"
    ]
  }
}
