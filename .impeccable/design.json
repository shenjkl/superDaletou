      "html": "<label class=\"ds-field\">训练截止期<input value=\"26123\" aria-describedby=\"ds-hint\"><small id=\"ds-hint\">必须早于目标期</small></label>",
      "css": ".ds-field{display:grid;gap:7px;font:600 12px/1.6 'Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--ink,#1c2d46)}.ds-field input{height:39px;border:1px solid #ced7e4;border-radius:6px;background:var(--surface,#fff);color:var(--ink,#1c2d46);padding:7px 10px;font:400 14px/1.6 'Segoe UI','Microsoft YaHei UI',sans-serif;min-width:0}.ds-field small{font-size:11px;font-weight:400;color:var(--muted,#607087)}.ds-field input:focus-visible{outline:3px solid #90aaff;outline-offset:3px}"
    },
