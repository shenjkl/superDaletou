      "html": "<nav><a class=\"ds-nav\" href=\"#overview\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>研究概览</a></nav>",
      "css": ".ds-nav{display:flex;gap:12px;align-items:center;padding:11px 13px;border-radius:8px;background:var(--primary-soft,#eef2ff);color:var(--primary,#365dca);text-decoration:none;font:650 13px/1.6 'Segoe UI','Microsoft YaHei UI',sans-serif}.ds-nav svg{width:19px;height:19px;flex-shrink:0}.ds-nav:hover{background:var(--primary-soft,#eef2ff)}.ds-nav:focus-visible{outline:3px solid #90aaff;outline-offset:3px}"
    },
